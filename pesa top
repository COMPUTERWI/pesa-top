<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PESA TOP | Admin Demo</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #101827;
    color: white;
    text-align: center;
}

header {
    padding: 20px;
    background: #080d17;
    font-size: 28px;
    font-weight: bold;
    color: #35e39a;
}

.container {
    max-width: 650px;
    margin: 25px auto;
    padding: 20px;
}

.panel {
    background: #1b2639;
    padding: 22px;
    margin-bottom: 18px;
    border-radius: 14px;
}

.multiplier {
    font-size: 65px;
    font-weight: bold;
    color: #35e39a;
    margin: 25px 0;
}

input {
    width: 85%;
    max-width: 350px;
    padding: 13px;
    border-radius: 7px;
    border: 1px solid #65738a;
    background: #0d1523;
    color: white;
    font-size: 17px;
}

button {
    padding: 13px 20px;
    margin: 7px;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    font-weight: bold;
    font-size: 15px;
}

.start { background: #35e39a; color: #07140f; }
.cash { background: #ffcc66; color: #201600; }
.stop { background: #ff657c; color: white; }

button:disabled {
    opacity: .4;
    cursor: not-allowed;
}

.status {
    color: #c3cee0;
    min-height: 24px;
    line-height: 1.5;
}

.warning {
    color: #ffcc66;
    font-size: 13px;
    line-height: 1.5;
}
</style>
</head>

<body>

<header>PESA TOP</header>

<div class="container">

    <div class="panel">
        <h2>Crash Game — Testing Mode</h2>

        <div id="multiplier" class="multiplier">1.00×</div>

        <p id="status" class="status">
            Set the next crash point to begin testing.
        </p>

        <button id="start" class="start">
            START ROUND
        </button>

        <button id="cash" class="cash" disabled>
            CASH OUT
        </button>
    </div>

    <div class="panel">
        <h2>Admin Controls</h2>

        <label for="crashPoint">
            Next round crash multiplier
        </label>

        <br><br>

        <input
            id="crashPoint"
            type="number"
            min="1.01"
            max="100"
            step="0.01"
            value="2.50"
        >

        <br><br>

        <button id="preview" class="start">
            PREVIEW NEXT ROUND
        </button>

        <p id="previewStatus" class="status">
            No round configured yet.
        </p>

        <p class="warning">
            DEMO ONLY: The preview reveals the configured outcome.
            All rounds use virtual results. This is not a secure
            production game or a real-money betting system.
        </p>
    </div>

    <div class="panel">
        <h2>Demo Account</h2>

        <p>
            Virtual balance:
            <strong id="balance">KSh 1,000.00</strong>
        </p>

        <label for="stake">Virtual stake (KSh)</label>

        <br><br>

        <input
            id="stake"
            type="number"
            min="1"
            max="1000"
            value="50"
        >

        <p id="result" class="status"></p>
    </div>

</div>

<script>
const multiplierDisplay = document.getElementById("multiplier");
const statusDisplay = document.getElementById("status");
const previewStatus = document.getElementById("previewStatus");
const balanceDisplay = document.getElementById("balance");
const resultDisplay = document.getElementById("result");

const startButton = document.getElementById("start");
const cashButton = document.getElementById("cash");
const previewButton = document.getElementById("preview");

let balance = 1000;
let stake = 50;
let crashPoint = null;
let currentMultiplier = 1;
let roundRunning = false;
let cashedOut = false;
let roundStartedAt = 0;
let animationFrame = null;

function money(amount) {
    return "KSh " + amount.toLocaleString("en-KE", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });
}

function updateBalance() {
    balanceDisplay.textContent = money(balance);
}

function previewRound() {
    if (roundRunning) {
        previewStatus.textContent =
            "Finish the current round before configuring another.";
        return;
    }

    const value = Number(
        document.getElementById("crashPoint").value
    );

    if (!Number.isFinite(value) || value < 1.01 || value > 100) {
        previewStatus.textContent =
            "Enter a crash point between 1.01× and 100×.";
        crashPoint = null;
        return;
    }

    crashPoint = value;

    previewStatus.textContent =
        "TEST PREVIEW: This round is configured to crash at " +
        crashPoint.toFixed(2) + "×.";
}

function finishRound() {
    roundRunning = false;

    cancelAnimationFrame(animationFrame);

    startButton.disabled = false;
    cashButton.disabled = true;

    if (!cashedOut) {
        statusDisplay.textContent =
            "CRASHED at " + crashPoint.toFixed(2) +
            "×. Your virtual stake was lost.";

        multiplierDisplay.style.color = "#ff657c";

        resultDisplay.textContent =
            "Demo loss: " + money(stake);
    } else {
        statusDisplay.textContent =
            "Round ended at " + crashPoint.toFixed(2) + "×.";
    }
}

function animate(now) {
    if (!roundRunning) return;

    const elapsed = (now - roundStartedAt) / 1000;

    currentMultiplier = Math.exp(elapsed * 0.30);

    if (currentMultiplier >= crashPoint) {
        currentMultiplier = crashPoint;

        multiplierDisplay.textContent =
            crashPoint.toFixed(2) + "×";

        finishRound();
        return;
    }

    multiplierDisplay.textContent =
        currentMultiplier.toFixed(2) + "×";

    if (!cashedOut) {
        statusDisplay.textContent =
            "Round running — cash out before the crash.";
    }

    animationFrame = requestAnimationFrame(animate);
}

startButton.addEventListener("click", () => {
    if (crashPoint === null) {
        statusDisplay.textContent =
            "Configure and preview a crash point first.";
        return;
    }

    stake = Number(document.getElementById("stake").value);

    if (
        !Number.isFinite(stake) ||
        stake < 1 ||
        stake > balance
    ) {
        statusDisplay.textContent =
            "Enter a valid stake within your virtual balance.";
        return;
    }

    balance -= stake;
    updateBalance();

    currentMultiplier = 1;
    cashedOut = false;
    roundRunning = true;
    roundStartedAt = performance.now();

    multiplierDisplay.style.color = "#35e39a";
    multiplierDisplay.textContent = "1.00×";

    resultDisplay.textContent = "";
    statusDisplay.textContent = "Round started.";

    startButton.disabled = true;
    cashButton.disabled = false;
    previewButton.disabled = true;

    animationFrame = requestAnimationFrame(animate);
});

cashButton.addEventListener("click", () => {
    if (!roundRunning || cashedOut) return;

    cashedOut = true;

    const payout = stake * currentMultiplier;

    balance += payout;
    updateBalance();

    resultDisplay.textContent =
        "Virtual payout: " + money(payout);

    statusDisplay.textContent =
        "Cashed out at " + currentMultiplier.toFixed(2) + "×.";

    cashButton.disabled = true;
});

previewButton.addEventListener("click", previewRound);

// Allow configuration for a new round after the previous round ends.
const originalFinishRound = finishRound;

finishRound = function() {
    originalFinishRound();
    previewButton.disabled = false;
    crashPoint = null;
};

updateBalance();
</script>

</body>
</html>
